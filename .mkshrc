# .mkshrc



export HISTFILE="$HOME/.mksh_history"
export HISTSIZE=2000

source() {
    if [ -f "./$1" ]; then
        . "./$1"
    else
        . "$1"
    fi
}
# Aliases
alias vim="nvim"
alias vi="nvim"
alias l='ls -alh'
alias ll='ls -l'
alias ls='ls --color=auto' 


vcs_sync() {
    msg="${1:-Update/Switch}"
    if [ -d .git ] || git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        git add .
        nix flake update
        git add flake.lock
        git commit -m "$msg"
    elif [ -d .hg ] || hg root >/dev/null 2>&1; then
        hg add .
        nix flake update
        hg commit -A -m "$msg"
    else
        echo "vcs_sync: no git or hg repo found in $(pwd)" >&2
        return 1
    fi
}

alias update="cd /etc/nixos && vcs_sync 'Update/Switch' && doas nixos-rebuild switch --flake path:.#shitbox"
alias switch="cd /etc/nixos && vcs_sync 'Update/Switch' && doas nixos-rebuild switch --flake path:.#shitbox && cd ~"
alias cleanup="doas nix-collect-garbage -d"
alias test="nix-shell -p"
#alias fastfetch="fastfetch -c ~/.config/fastfetch/neofetch.jsonc"
export EDITOR="nvim"
export TERM="foot"

_VCS_PROMPT_SEGMENT=""
_VCS_CACHED_DIR=""

_update_vcs_segment() {
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        local branch
        branch=$(git branch --show-current 2>/dev/null)

        if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
            _VCS_PROMPT_SEGMENT=" ($branch*)"
        else
            _VCS_PROMPT_SEGMENT=" ($branch)"
        fi
    else
        _VCS_PROMPT_SEGMENT=$(hgfast -branch-only 2>/dev/null)
        if [ $? -ne 0 ]; then
            _VCS_PROMPT_SEGMENT=""
        fi
    fi
}

_vcs_chpwd_check() {
    local now_dir
    now_dir=$(pwd)
    if [ "$now_dir" != "$_VCS_CACHED_DIR" ]; then
        _VCS_CACHED_DIR="$now_dir"
        _update_vcs_segment
    fi
}
# Prompt Setup
set_prompt() {
    _vcs_chpwd_check
    local cur_dir=$(pwd)
    
    # Shorten /home/user to ~ POSIX-style
    if [ "$cur_dir" = "$HOME" ]; then
        cur_dir="~"
    else
        cur_dir="${cur_dir#$HOME/}"
        # If we are not in a subdirectory of HOME and not at root, 
        # prepend ~ only if it actually matched the home path strip
        if [ "$cur_dir" != "$(pwd)" ]; then
            cur_dir="~$cur_dir"
        fi
    fi
    echo "${cur_dir}${_VCS_PROMPT_SEGMENT} $ "
}
PS1='$(set_prompt)'
export PATH="$HOME/.local/bin:$HOME/.config/2bwc/bin:$PATH"
# Startup
set -o emacs
bind '^L=clear-screen'
