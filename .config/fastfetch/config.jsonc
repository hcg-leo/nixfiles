{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
	    "right": 2
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "type": "custom"
        },
        {
            "key": " {#31} user    {#keys}",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": " {#32} hname   {#keys}",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": " {#34} distro  {#keys}",
            "type": "os",
	    "format": "{2} {5}"
        },
        {
            "key": " {#35} kernel  {#keys}",
            "type": "kernel",
	    "format": "{1}"
        },
        {
            "key": " {#36} desktop {#keys}",
            "type": "wm",
	    "format": "{1}"
        },
        {
            "key": " {#31} term    {#keys}",
            "type": "terminal",
	    "format": "{1}"
        },
        {
            "key": " {#32} shell   {#keys}",
            "type": "shell",
     	    "format": "{1}"
        },
	"break",
        {
            "type": "colors",
	    "symbol": "circle",
        },

        
    ]
}
